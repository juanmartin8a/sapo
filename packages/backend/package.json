{
  "name": "@sapo/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./constants/*": "./convex/constants/*.ts"
  },
  "scripts": {
    "dev": "bun run prompts:generate && convex dev",
    "deploy": "bun run prompts:generate && convex deploy",
    "codegen": "convex codegen",
    "prompts:generate": "node scripts/generate-ai-prompts.mjs",
    "prompts:check": "node scripts/generate-ai-prompts.mjs --check",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "lint": "eslint convex scripts"
  },
  "dependencies": {
    "@better-auth/expo": "~1.7.21",
    "@convex-dev/better-auth": "^0.13.0",
    "better-auth": "~1.7.21",
    "convex": "^1.49.0",
    "zod": "4.6.7",
    "@convex-dev/resend": "^0.2.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "24.19.2",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "typescript": "6.0.3",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "eslint-config-expo": "~58.0.4"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-typescript",
              {
                "allowDeclareFields": true
              }
            ]
          ],
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    }
  }
}
