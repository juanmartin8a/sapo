{
  "name": "sapo",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --filter @sapo/mobile start",
    "dev:mobile": "bun run --filter @sapo/mobile start",
    "dev:web": "bun run --filter @sapo/web dev",
    "dev:backend": "bun run --filter @sapo/backend dev",
    "ios": "bun run --filter @sapo/mobile ios",
    "android": "bun run --filter @sapo/mobile android",
    "web": "bun run --filter @sapo/web dev",
    "convex:dev": "bun run --filter @sapo/backend dev",
    "convex:deploy": "bun run --filter @sapo/backend deploy",
    "convex:codegen": "bun run --filter @sapo/backend codegen",
    "prompts:generate": "bun run --filter @sapo/backend prompts:generate",
    "prompts:check": "bun run --filter @sapo/backend prompts:check",
    "typecheck": "bun run --filter \"*\" typecheck",
    "lint": "bun run --filter \"*\" lint",
    "test": "bun run --filter \"*\" test",
    "build:web": "bun run --filter @sapo/web build",
    "dev:app": "bun run --filter @sapo/web dev",
    "build:app": "bun run --filter @sapo/web build:node"
  },
  "trustedDependencies": [
    "react-native-litert-lm"
  ],
  "overrides": {
    "@solidjs/compiler": "2.0.0-rc.18",
    "@solidjs/babel-plugin": "2.0.0-rc.18",
    "@solidjs/signals": "2.0.0-rc.18",
    "@tanstack/start-server-core": "1.169.40",
    "@tanstack/start-client-core": "1.170.35",
    "@tanstack/start-storage-context": "1.167.37",
    "@tanstack/history": "1.162.5",
    "@tanstack/router-core": "1.171.35"
  },
  "patchedDependencies": {
    "@tanstack/solid-router@2.0.0-rc.9": "patches/@tanstack%2Fsolid-router@2.0.0-rc.9.patch"
  }
}
