{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "DOM",
            "DOM.Iterable",
            "ES2022"
        ],
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": [
            "vite/client",
            "node"
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "ignoreDeprecations": "6.0"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vite.config.ts",
        "tests/**/*.ts"
    ]
}
