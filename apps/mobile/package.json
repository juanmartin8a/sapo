{
  "name": "@sapo/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "lint": "expo lint app components hooks stores lib providers utils constants types",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@sapo/backend/api$": "<rootDir>/../../packages/backend/convex/_generated/api.js",
      "^@sapo/backend/constants/(.*)$": "<rootDir>/../../packages/backend/convex/constants/$1",
      "^@sapo/client-core/(.*)$": "<rootDir>/../../packages/client-core/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|\\.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@better-auth/expo": "~1.6.26",
    "@convex-dev/better-auth": "^0.12.5",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/ui": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "better-auth": "~1.6.26",
    "convex": "^1.41.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.8",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-litert-lm": "^0.5.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-otp-entry": "^1.8.6",
    "react-native-pager-view": "8.0.4",
    "react-native-purchases": "^9.10.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.3.6",
    "zustand": "^5.0.3",
    "@sapo/backend": "workspace:*",
    "@babel/runtime": "7.28.6",
    "@sapo/client-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/react": "~19.2.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.2.1",
    "jest-expo": "~57.0.3",
    "react-native-svg-transformer": "^1.5.0",
    "typescript": "6.0.3",
    "@jest/globals": "^29.2.1",
    "@types/node": "25.3.0",
    "react-test-renderer": "19.2.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "trustedDependencies": [
    "react-native-litert-lm"
  ],
  "private": true
}
