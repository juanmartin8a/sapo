{
  "name": "@sapo/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll=false",
    "lint": "expo lint app components hooks stores lib providers utils constants types",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@sapo/backend/api$": "<rootDir>/../../packages/backend/convex/_generated/api.js",
      "^@sapo/backend/constants/(.*)$": "<rootDir>/../../packages/backend/convex/constants/$1",
      "^@sapo/client-core/(.*)$": "<rootDir>/../../packages/client-core/src/$1"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(\\.bun|\\.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "dependencies": {
    "@babel/runtime": "7.29.14",
    "@better-auth/expo": "~1.7.21",
    "@convex-dev/better-auth": "^0.13.0",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.28",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@sapo/backend": "workspace:*",
    "@sapo/client-core": "workspace:*",
    "better-auth": "~1.7.21",
    "convex": "^1.49.0",
    "expo": "^58.0.24",
    "expo-apple-authentication": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-litert-lm": "^0.8.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-otp-entry": "^1.8.6",
    "react-native-pager-view": "9.0.7",
    "react-native-purchases": "~10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@jest/globals": "~30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "trustedDependencies": [
    "react-native-litert-lm"
  ],
  "private": true
}
