# Private runtime variables; use the libSQL database populated by sapo-mpr.
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
# Create a separate website token: turso db tokens create <database-name> --read-only
TURSO_AUTH_TOKEN=

# Same deployment as the mobile app. Both URLs are public.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Optional Stripe foundation; subscriptions and Checkout are intentionally disabled.
# Never prefix secrets with VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
